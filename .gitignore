# ==========================================
# UE5 Project - RoboSimUE
# ==========================================
# Engine build/artifact folders
RoboSimUE/Binaries/
RoboSimUE/Build/
RoboSimUE/DerivedDataCache/
RoboSimUE/Intermediate/
RoboSimUE/Saved/
RoboSimUE/Source/RoboSimUE/Vaiant_Combat/
RoboSimUE/Source/RoboSimUE/Variant_Platforming/
RoboSimUE/Source/RoboSimUE/Variant_SideScrolling/

# Plugins (build outputs)
RoboSimUE/Plugins/*/Binaries/
RoboSimUE/Plugins/*/Intermediate/

# Project IDE/workspace files (can be regenerated)
RoboSimUE/*.sln
RoboSimUE/*.xcworkspace

# ==========================================
# Development environments & IDEs
# ==========================================
# Visual Studio
.vs/
*.sln
*.VC.db
*.opensdf
*.opendb
*.sdf
*.suo

# VS Code / JetBrains
.vscode/
/.idea/

# ==========================================
# Python / Backend
# ==========================================
# Bytecode, caches, virtual environments
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
pip-wheel-metadata/

# Local virtualenvs (project-specific)
backend/.venv/
backend/.env
.venv/
venv/
env/

# ROS 2 workspace outputs
backend/build/
backend/install/
backend/log/

# ==========================================
# Assets, generated files, and large exports
# ==========================================
# Ignore large generated asset exports but keep source meshes tracked.
*.glb
*.gltf
*.urdf
.stl
.obj
# Explicitly ignore MuJoCo menagerie if present (large, external dataset)
backend/assets/robots/
backend/assets/environment/

# Don't ignore backend/assets/ entirely — keep authored meshes/versioned data tracked

# ==========================================
# Logs, debug, and local-only files
# ==========================================
*.log
debug_world.xml
*.tmp
*~

# ==========================================
# OS files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini

# ==========================================
# Local tooling / workspace files (non-source)
# ==========================================
CLAUDE.local.md
.planning/
.mcp.json
docs/
CLAUDE.md
GEMINI.md
.gemini
conductor/ 
.claude
AGENTS.md
.agents/

